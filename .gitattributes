# Keep source-controlled content byte-stable across Windows, Linux, and macOS.
* text=auto

*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.txt  text eol=lf
VERSION text eol=lf
LICENSE text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
