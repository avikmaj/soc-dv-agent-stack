{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/avikmaj/soc-dv-agent-stack/schemas/verification-plan.schema.json",
  "title": "Verification Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "scope",
    "requirements",
    "risks",
    "signoff_criteria"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/risk"
      }
    },
    "signoff_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "priority",
        "methods",
        "checks",
        "coverage"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^REQ-[A-Z0-9_-]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "simulation",
              "formal",
              "assertion",
              "static",
              "software",
              "emulation",
              "review"
            ]
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "likelihood",
        "impact",
        "mitigation",
        "owner"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^RISK-[A-Z0-9_-]+$"
        },
        "description": {
          "type": "string"
        },
        "likelihood": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "impact": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "mitigation": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        }
      }
    }
  }
}
