{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/avikmaj/soc-dv-agent-stack/schemas/traceability.schema.json",
  "title": "Requirement Traceability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "status",
          "evidence"
        ],
        "properties": {
          "requirement_id": {
            "type": "string"
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assertions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "coverpoints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "open",
              "implemented",
              "passing",
              "failing",
              "waived",
              "blocked"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "owner": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
