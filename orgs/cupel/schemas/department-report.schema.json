{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/avikmaj/soc-dv-agent-stack/orgs/cupel/schemas/department-report.schema.json",
  "title": "Cupel Department Report (CUPEL-REPORT)",
  "$defs": {
    "evidence_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "area",
        "status",
        "rank",
        "minted_by",
        "provenance",
        "missing_fields",
        "supports_claims"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^C-[0-9]+/EV-[a-z]+-[0-9]+$"
        },
        "area": {
          "enum": [
            "compile",
            "elaborate",
            "sim",
            "regression",
            "assertion",
            "formal",
            "coverage",
            "lint",
            "synth",
            "cdc",
            "rdc",
            "reset",
            "upf",
            "perf",
            "security",
            "parity",
            "other"
          ]
        },
        "status": {
          "enum": [
            "CURRENT",
            "STALE",
            "UNVERIFIED-RECORD"
          ]
        },
        "rank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "minted_by": {
          "const": "cupel-evidence-vault"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "revision",
            "config_hash",
            "tool",
            "tool_version",
            "argv",
            "run_id",
            "started_at",
            "finished_at",
            "report_path",
            "owner",
            "reproduced"
          ],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "config_hash": {
              "type": "string",
              "minLength": 1
            },
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "tool_version": {
              "type": "string",
              "minLength": 1
            },
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "run_id": {
              "type": "string",
              "minLength": 1
            },
            "started_at": {
              "type": "string",
              "minLength": 1
            },
            "finished_at": {
              "type": "string",
              "minLength": 1
            },
            "report_path": {
              "type": "string",
              "minLength": 1
            },
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "reproduced": {
              "enum": [
                "this-session",
                "ci-immutable",
                "report-only",
                "MISSING"
              ]
            }
          }
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supports_claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflicting_with": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^C-[0-9]+/EV-[a-z]+-[0-9]+$"
          }
        },
        "currency_basis": {
          "type": "string"
        }
      }
    },
    "dissent_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "case",
        "raised_by",
        "class",
        "status",
        "statement",
        "basis",
        "discriminating_command",
        "cleared_by",
        "accepted_by",
        "verbatim"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^C-[0-9]+/DL-[a-z][a-z-]*[a-z]-[0-9]{3}$"
        },
        "case": {
          "type": "string",
          "pattern": "^C-[0-9]+$"
        },
        "raised_by": {
          "type": "string",
          "pattern": "^cupel-[a-z][a-z-]*[a-z]$"
        },
        "class": {
          "enum": [
            "BLOCKING",
            "ADVISORY"
          ]
        },
        "status": {
          "enum": [
            "OPEN",
            "CLEARED",
            "ACCEPTED"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "claim_class",
            "rank"
          ],
          "properties": {
            "claim_class": {
              "enum": [
                "Observed",
                "Derived",
                "Assumed",
                "Unverified",
                "Proposed"
              ]
            },
            "rank": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            }
          }
        },
        "discriminating_command": {
          "type": "string",
          "minLength": 1
        },
        "cleared_by": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^C-[0-9]+/EV-[a-z]+-[0-9]+$"
        },
        "accepted_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "raised_at": {
          "type": "string"
        },
        "defect_of": {
          "type": "string"
        },
        "verbatim": {
          "const": true
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "claim_class",
        "statement",
        "severity",
        "rank",
        "evidence_refs",
        "affected_files",
        "affected_requirements"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^F-[0-9]{3}$"
        },
        "claim_class": {
          "enum": [
            "Observed",
            "Derived",
            "Assumed",
            "Unverified",
            "Proposed"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "high",
            "medium",
            "low",
            "info"
          ]
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(none|C-[0-9]+/EV-[a-z]+-[0-9]+)$"
          }
        },
        "affected_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "affected_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "face",
    "case",
    "mode",
    "path",
    "claims_of_success",
    "findings",
    "evidence_records",
    "requirement_states",
    "ledger_entries",
    "ceiling_suggestion",
    "verdict",
    "ceiling_computation",
    "human_decisions",
    "validation_performed",
    "next_commands",
    "residual_gaps",
    "ledger_control",
    "chamber_pass"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "face": {
      "type": "string",
      "pattern": "^cupel-[a-z][a-z-]*[a-z]$"
    },
    "case": {
      "type": "string",
      "pattern": "^C-[0-9]+$"
    },
    "mode": {
      "enum": [
        "read-only",
        "planning",
        "implementation",
        "validation",
        "challenge"
      ]
    },
    "path": {
      "enum": [
        "review",
        "verdict"
      ]
    },
    "claims_of_success": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "word",
          "source",
          "quote"
        ],
        "properties": {
          "word": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": [
              "integer",
              "string"
            ]
          },
          "quote": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "evidence_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^C-[0-9]+/EV-[a-z]+-[0-9]+$"
          },
          "status": {
            "enum": [
              "CURRENT",
              "STALE",
              "UNVERIFIED-RECORD"
            ]
          },
          "rank": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          }
        }
      }
    },
    "minted_records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_record"
      }
    },
    "requirement_states": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement",
          "state",
          "record"
        ],
        "properties": {
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "none",
              "Exercised",
              "Checked",
              "Qualified"
            ]
          },
          "record": {
            "type": "string",
            "pattern": "^(none|C-[0-9]+/EV-[a-z]+-[0-9]+)$"
          }
        }
      }
    },
    "ledger_entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dissent_entry"
      }
    },
    "ceiling_suggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "reasons"
      ],
      "properties": {
        "value": {
          "enum": [
            "NOT READY",
            "CONDITIONAL",
            "PASS-eligible"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "verdict": {
      "enum": [
        "NONE",
        "NONE (ceiling-setter not run)",
        "PASS",
        "CONDITIONAL",
        "NOT READY"
      ]
    },
    "ceiling_computation": {
      "type": [
        "string",
        "array"
      ],
      "items": {
        "type": "string"
      }
    },
    "human_decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_performed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "residual_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ledger_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "received",
        "returned_unchanged",
        "defects_recorded"
      ],
      "properties": {
        "received": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dissent_entry"
          }
        },
        "returned_unchanged": {
          "const": true
        },
        "defects_recorded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "chamber_pass": {
      "type": "string",
      "pattern": "^(NONE|NONE \\(ceiling-setter not run\\)|C-[0-9]+/CP-[0-9]+)$"
    },
    "stations": {
      "type": "array",
      "items": {
        "enum": [
          "claim-challenger",
          "ledger-reconciler",
          "ceiling-setter"
        ]
      }
    }
  }
}
